# ── Copy to .env and edit. NEVER commit your real .env ──────────────────────
#   cp env.example .env

# REQUIRED: sign JWTs with a strong random string (>= 32 bytes).
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# JWT settings (optional)
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7

# SQLite database location (relative to repo root)
DATABASE_URL=sqlite:///./data/app.db

# Comma-separated CORS origins. Dev defaults to the Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# MUST stay false in production (verbose errors leak internals)
DEBUG=false

# ── Admin bootstrap — CHANGE THESE before any real deployment ───────────────
ADMIN_USERNAME=admin
DEFAULT_PASSWORD=changeme

# ── Question pipeline (only needed if you import your own PDFs) ──────────────
# Directory holding your past-exam source PDFs.
PAST_PAPER_DIR=./source_pdfs
PAST_PAPER_YEARS=112,113,114

# Shown in the UI; bump when you load a new batch of questions.
DB_UPDATED_DATE=2026-06-11
# Exam date (ISO) used for the countdown and score prediction.
EXAM_DATE=2026-09-13
# In-question timer pace = total minutes × 60 ÷ number of questions.
# (Timer turns amber at 0.75× and red at 1×.) 48 = a 200-Q / 160-min paper.
EXAM_SECONDS_PER_Q=48
# Whether the "shared wrong-answer bank" (cohort) is visible to non-admins.
COHORT_WRONGBOOK_PUBLIC=true

# ── Optional: local LLM for question QA (not required to run) ────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
